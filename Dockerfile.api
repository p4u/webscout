# ── Stage 1: dependency cache ────────────────────────────────────────────────
# Copy only the manifest files first so that a source-only change does not
# invalidate this expensive layer.
FROM rust:1-slim-bookworm AS deps

WORKDIR /build

# Install build-time C toolchain needed by the `ring` TLS crate.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./

# Create a stub main so cargo can fully resolve and compile all dependencies
# without the real source.  The stub is replaced in the next stage.
RUN mkdir -p src && \
    echo 'fn main() {}' > src/main.rs && \
    cargo build --release && \
    rm -rf src

# ── Stage 2: application build ───────────────────────────────────────────────
FROM deps AS builder

COPY src/ src/

# Touch main.rs so cargo notices the source changed vs. the stub.
RUN touch src/main.rs && \
    cargo build --release

# ── Stage 3: minimal runtime ─────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

# CA certificates are required for every outbound HTTPS request.
# curl is used only by the HEALTHCHECK instruction.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for the process.
RUN useradd --system --uid 1001 --no-create-home webscout

COPY --from=builder /build/target/release/webscout /usr/local/bin/webscout

# Obscura, the headless browser this tool drives as a subprocess. Both binaries
# ship in one release archive and must sit side by side: `obscura scrape` spawns
# `obscura-worker` processes, which is the whole reason batching is fast.
#
# The archive is ~80 MB and expands to ~200 MB, which is most of this image.
# Verified 2026-09-21 on debian:bookworm-slim: the binaries need only libgcc,
# libm and libc, all already present, and a real scrape of DuckDuckGo's HTML
# endpoint returned 10 results from inside a bare container. Without them the
# `ddg` search lane is unavailable, and a run with no Jina key exits at startup
# because no search engine is left.
ARG OBSCURA_URL=https://github.com/h4ckf0r0day/obscura/releases/latest/download/obscura-x86_64-linux.tar.gz
RUN curl -fsSL "$OBSCURA_URL" -o /tmp/obscura.tar.gz \
    && tar xzf /tmp/obscura.tar.gz -C /usr/local/bin obscura obscura-worker \
    && chmod +x /usr/local/bin/obscura /usr/local/bin/obscura-worker \
    && rm -f /tmp/obscura.tar.gz \
    && obscura --version

USER webscout

# Port the API listens on inside the container (not published by compose).
EXPOSE 8080

# A host-built obscura can still be mounted onto /opt/obscura to override the
# bundled one (see docker-compose.yml); anything found there wins on PATH.
ENV PATH="/opt/obscura:${PATH}"

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8080/api/health || exit 1

CMD ["webscout", "--api", "--api-port", "8080"]
