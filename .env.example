# Copy to .env and fill in the required values.
#
# Two uses:
#   Shell use:   source .env         (add "export " prefixes, or use the repo's
#                                     gitignored `env` file which already has them)
#   Docker Compose: env_file: .env   (requires KEY=value form — NO "export" prefix;
#                                     that is why this file has none)
#
# Flags always beat environment variables. Nothing is compiled into the binary.

# Required. https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Optional override.
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Required. The writer: extraction, enrichment templates, answer synthesis.
# Hundreds of mechanical calls per run, so it wants a fast non-reasoning model.
# Any OpenAI-compatible server works, but the endpoint must be the full chat
# completions URL; a base URL is rejected at startup.
WEBSCOUT_LLM_API_KEY=
# WEBSCOUT_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# WEBSCOUT_LLM_MODEL=google/gemma-4-31b-it

# Optional. The planner: research plan, mission parse, re-aim, query writing.
# A handful of reasoning-shaped calls per run. Endpoint and key default to the
# writer's, so setting the model alone is enough to split the roles.
# WEBSCOUT_PLANNER_MODEL=qwen/qwen3.8-27b
# WEBSCOUT_PLANNER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# WEBSCOUT_PLANNER_KEY=

# Optional. How to tell the endpoint to disable reasoning. auto (default)
# uses the OpenRouter form for openrouter.ai and does nothing elsewhere.
# Options: auto | openrouter | vllm | effort | off
# Use vllm for vLLM-backed servers (e.g. vllm.example.org): measured
# 58.3s→1.4s on an extraction call by disabling chat_template_kwargs.enable_thinking.
# WEBSCOUT_THINKING_CONTROL=auto
# WEBSCOUT_PLANNER_THINKING_CONTROL=auto

# Optional. Supplying this switches fetching from a local obscura to Jina's
# hosted search + reader. Without it, obscura is used and must be on PATH.
# JINA_API_KEY=
